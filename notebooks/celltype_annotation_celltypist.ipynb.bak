   "source": [
    "adata.uns.pop('leiden_colors')\n",
    "sq.pl.spatial_scatter(\n",
    "    adata,\n",
    "    library_id=\"spatial\",\n",
    "    shape=None,\n",
    "    color=[\n",
    "        \"leiden\",\n",
    "    ],\n",
    "    wspace=0.4,\n",
    "    figsize=(12, 12)\n",
    ")\n"
   ]
  },
