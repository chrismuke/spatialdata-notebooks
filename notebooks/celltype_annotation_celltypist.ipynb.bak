      "Name: n_transcripts, dtype: float32\n"
     ]
    }
   ],
   "source": [
    "# Calculate total transcripts for each individual cell\n",
    "adata.obs['n_transcripts'] = np.array(adata.X.sum(axis=1)).flatten()\n",
    "\n",
    "# Group by cluster and calculate the mean\n",
    "avg_transcripts_per_cell = adata.obs.groupby('leiden')['n_transcripts'].mean()\n",
    "\n",
    "print(\"\\nAverage number of transcripts per cell in each cluster:\")\n",
    "print(avg_transcripts_per_cell)"
   ]
  },
  {
   "cell_type": "code",
